{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudcourt",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "preview_urls": true,
  "ai": { "binding": "AI" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudcourt-db",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "observability": { "enabled": true }
}
